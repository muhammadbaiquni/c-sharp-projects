<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="GreenFolderBrush" Color="ForestGreen" />
    <SolidColorBrush x:Key="YellowFolderBrush" Color="Goldenrod" />
    <Geometry x:Key="FolderGeometry">M 1,3 L 1,1 L 7,1 L 9,3 L 19,3 L 19,15 L 1,15 Z M 1,5 L 19,5</Geometry>
    <Thickness x:Key="ControlPadding">10,4</Thickness>
    <Style TargetType="Button">
        <Setter Property="Padding" Value="{StaticResource ControlPadding}"/>
        <Setter Property="MinHeight" Value="28"/>
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="GroupBox">
        <Setter Property="Padding" Value="8"/>
    </Style>
</ResourceDictionary>
