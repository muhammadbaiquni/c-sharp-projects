<Window x:Class="MpcplBuilder.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MpcplBuilder.Wpf.Views"
        Title="MPC Playlist Builder" Height="520" Width="820"
        WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/MpcplBuilder.Wpf;component/ic_playlist_add_128_28561.png">
    <TabControl x:Name="ShellTabs" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
        <TabItem Header="Explorer">
            <Grid DataContext="{Binding Explorer}">
                <TextBlock Text="Explorer" Margin="16" />
            </Grid>
        </TabItem>
        <TabItem Header="Default">
            <views:DefaultView DataContext="{Binding Default}" />
        </TabItem>
    </TabControl>
</Window>
