<Window x:Class="MpcplBuilder.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MPC Playlist Builder" Height="520" Width="820"
        WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/MpcplBuilder.Wpf;component/ic_playlist_add_128_28561.png">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Root folder -->
        <StackPanel Orientation="Horizontal" Grid.Row="0">
            <TextBlock Text="Root Folder:" VerticalAlignment="Center" Width="90"/>
            <TextBox x:Name="RootTextBox" Text="{Binding RootPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,8,0" Width="560" AutomationProperties.Name="Root folder" KeyboardNavigation.TabIndex="0"/>
            <Button x:Name="BrowseButton" Content="Browse..." Width="100" Command="{Binding BrowseCommand}" AutomationProperties.Name="Browse for root folder" KeyboardNavigation.TabIndex="1"/>
        </StackPanel>

        <!-- Path Type Options -->
        <StackPanel Orientation="Horizontal" Grid.Row="2">
            <TextBlock Text="Path Type:" VerticalAlignment="Center" Width="90"/>
            <RadioButton x:Name="RelativePathRadioButton" Content="Relative Path (Portable)" IsChecked="{Binding IsRelativePath, Mode=TwoWay}" GroupName="PathType" Margin="8,0,16,0" VerticalAlignment="Center" AutomationProperties.Name="Relative path" KeyboardNavigation.TabIndex="2"/>
            <RadioButton x:Name="FullPathRadioButton" Content="Full Path" IsChecked="{Binding IsFullPath, Mode=TwoWay}" GroupName="PathType" Margin="0,0,16,0" VerticalAlignment="Center" AutomationProperties.Name="Full path" KeyboardNavigation.TabIndex="3"/>
            <RadioButton x:Name="LongPathRadioButton" Content="Long Path (\\?\)" IsChecked="{Binding IsLongPath, Mode=TwoWay}" GroupName="PathType" VerticalAlignment="Center" AutomationProperties.Name="Long path" KeyboardNavigation.TabIndex="4"/>
        </StackPanel>

        <!-- Output info (read-only) -->
        <StackPanel Orientation="Horizontal" Grid.Row="4">
            <TextBlock Text="Output:" VerticalAlignment="Center" Width="98"/>
            <TextBlock x:Name="OutputInfoTextBlock" Text="{Binding OutputInfo}" Width="653" />
        </StackPanel>

        <!-- Preview -->
        <GroupBox Header="Preview (first 200 items)" Grid.Row="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ListBox x:Name="PreviewListBox" Grid.Row="0" ItemsSource="{Binding PreviewItems}" />
                <TextBlock x:Name="CountsTextBlock" Grid.Row="1" Margin="0,6,0,0" Text="{Binding Counts}" />
            </Grid>
        </GroupBox>

        <!-- Footer -->
        <DockPanel Grid.Row="8">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button x:Name="GenerateButton" Content="Generate" Width="120" Command="{Binding GenerateCommand}" Margin="0,0,8,0" AutomationProperties.Name="Generate playlist" KeyboardNavigation.TabIndex="5"/>
                <Button x:Name="ClearButton" Content="Clear" Width="100" Command="{Binding ClearCommand}" AutomationProperties.Name="Clear preview" KeyboardNavigation.TabIndex="6"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Width="542">
                <ProgressBar x:Name="ProgressBarControl" Width="180" Height="18" IsIndeterminate="{Binding IsProgressIndeterminate}" Minimum="0" Maximum="100" Visibility="{Binding ProgressVisibility}" Margin="0,0,10,0"/>
                <Button x:Name="CancelButton" Content="Cancel" Width="70" Margin="0,0,8,0" Command="{Binding CancelCommand}" Visibility="{Binding IsProgressIndeterminate, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.Name="Cancel active operation" KeyboardNavigation.TabIndex="7" />
                <TextBlock x:Name="StatusTextBlock" VerticalAlignment="Center" Text="{Binding Status}" RenderTransformOrigin="0,0.5"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
