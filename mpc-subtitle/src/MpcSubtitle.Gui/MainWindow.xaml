<Window x:Class="MpcSubtitle.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MpcSubtitle.Gui.ViewModels"
        xmlns:converters="clr-namespace:MpcSubtitle.Gui.Converters"
        Title="MpcSubtitle — Subtitle Generator"
        Height="700" Width="1000" MinHeight="520" MinWidth="800"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <converters:FolderCoverageToBrushConverter x:Key="FolderCoverageBrush"/>
        <HierarchicalDataTemplate DataType="{x:Type vm:FolderNodeViewModel}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="0,1">
                <Path Data="M2,4 L8,4 L10,6 L18,6 L18,16 L2,16 Z" Width="16" Height="14"
                      Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"
                      Fill="{Binding Coverage, Converter={StaticResource FolderCoverageBrush}}"
                      Stroke="#8A8A8A" StrokeThickness="0.7"/>
                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Focusable="False" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Name}" Margin="4,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="170"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" VerticalAlignment="Center">
            <TextBlock Text="Model:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <ComboBox ItemsSource="{Binding ModelNames}" SelectedItem="{Binding SelectedModel}"
                      Width="110" Margin="0,0,16,0"/>

            <TextBlock Text="Language:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox Text="{Binding Language, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="0,0,16,0"
                     ToolTip="ISO language code, or 'auto' for detection"/>

            <TextBlock Text="ffmpeg:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox Text="{Binding FfmpegPath}" Width="240" Margin="0,0,4,0" IsReadOnly="True"
                     ToolTip="Selected ffmpeg path — leave blank to find ffmpeg on PATH"/>
            <Button Content="Browse…" Margin="0,0,16,0" Padding="8,0" Click="OnBrowseFfmpeg"/>

            <CheckBox Content="Split first-level folders as roots" IsChecked="{Binding SplitFirstLevel}"
                      VerticalAlignment="Center"/>
        </WrapPanel>

        <GroupBox Header="Folders (check to select)" Grid.Row="1" Margin="0,8,0,0">
            <TreeView x:Name="FoldersTree" ItemsSource="{Binding Roots}">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                    </Style>
                </TreeView.ItemContainerStyle>
            </TreeView>
        </GroupBox>

        <GroupBox Header="Log" Grid.Row="2" Margin="0,8,0,0">
            <ListBox x:Name="LogList" ItemsSource="{Binding LogLines}"
                     FontFamily="Consolas" FontSize="12" BorderThickness="0"/>
        </GroupBox>

        <StackPanel Grid.Row="3" Margin="0,8,0,0">
            <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding Progress}"/>
            <TextBlock Text="{Binding StatusText}" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Cancel" Command="{Binding CancelCommand}" Width="90" Margin="0,0,8,0"/>
            <Button Content="Generate" Command="{Binding GenerateCommand}" Width="120" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
